datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  THEATRE_ADMIN
  THEATRE_STAFF
  PRODUCTION_COMPANY
}

enum ContentStatus {
  DRAFT
  UPLOADING
  PROCESSING
  READY
  PUBLISHED
  ARCHIVED
}

enum ReleaseStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ShowStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  ISSUED
  ACTIVATED
  USED
  CANCELLED
}

enum ActivationStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

enum VerificationResult {
  VERIFIED
  DENIED
}

enum VideoAssetState {
  CREATED
  PROCESSING
  READY
  BLOCKED
  ARCHIVED
}

enum ProcessingStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum DrmProviderType {
  MOCK
  WIDEVINE
  PLAYREADY
  FAIRPLAY
  CUSTOM
}

enum DrmStatus {
  NOT_CONFIGURED
  QUEUED
  PROCESSING
  READY
  FAILED
  REVOKED
}

enum DrmLicenseStatus {
  ISSUED
  ACTIVE
  EXPIRED
  REVOKED
  DENIED
}

enum PlaybackSessionStatus {
  AUTHORIZED
  ACTIVE
  EXPIRED
  TERMINATED
  DENIED
}

enum ProtectionEventType {
  SESSION_STARTED
  SESSION_HEARTBEAT
  SESSION_EXPIRED
  SESSION_REVOKED
  PLAYER_STARTED
  PLAYER_STOPPED
  FULLSCREEN_ENTERED
  FULLSCREEN_EXITED
  SCREENSHOT_ATTEMPT_DETECTED
  PLAYBACK_AUTHORIZED
  PLAYBACK_DENIED
  PLAYBACK_STARTED
  PLAYBACK_STOPPED
  PLAYBACK_TERMINATED
  PLAYBACK_AUTH_EXPIRED
  DRM_LICENSE_REQUESTED
  DRM_LICENSE_AUTHORIZED
  DRM_LICENSE_DENIED
  DRM_LICENSE_REVOKED
  DRM_ENCRYPTION_STARTED
  DRM_ENCRYPTION_COMPLETED
  DRM_ENCRYPTION_FAILED
}

model ProductionCompany {
  id                   String                @id @default(uuid())
  name                 String
  code                 String                @unique
  contactEmail         String
  contactPhone         String?
  status               String                @default("ACTIVE")
  users                User[]
  movies               Movie[]
  releases             MovieRelease[]
  videoAssets          VideoAsset[]
  evidenceRecords      EvidenceRecord[]
  investigationCases   InvestigationCase[]
  threatIntelCampaigns ThreatIntelCampaign[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([name])
  @@index([code])
  @@index([status])
}

model User {
  id                        String                    @id @default(uuid())
  email                     String                    @unique
  passwordHash              String
  name                      String
  role                      UserRole                  @default(THEATRE_STAFF)
  theatreId                 String?
  theatre                   Theatre?                  @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  productionCompanyId       String?
  productionCompany         ProductionCompany?        @relation(fields: [productionCompanyId], references: [id], onDelete: SetNull)
  verifications             Verification[]
  assignedIncidents         PiracyIncident[]
  assignedSecurityIncidents SecurityIncident[]        @relation("AssignedSecurityIncidents")
  assignedCases             InvestigationCase[]       @relation("AssignedCases")
  investigationAssignments  InvestigationAssignment[]
  investigationNotes        InvestigationNote[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([email])
  @@index([role])
  @@index([productionCompanyId])
}

model Theatre {
  id                           String                         @id @default(uuid())
  name                         String
  code                         String                         @unique
  permanentQrCode              String?                        @unique
  location                     String
  address                      String?
  contactEmail                 String?
  contactPhone                 String?
  screens                      Screen[]
  shows                        Show[]
  users                        User[]
  verifications                Verification[]
  protectionEvents             ProtectionEvent[]
  movieReleases                MovieRelease[]
  playbackSessions             PlaybackSession[]
  drmLicenses                  DrmLicense[]
  incidents                    PiracyIncident[]
  securityIncidents            SecurityIncident[]
  threatAlerts                 ThreatAlert[]
  playbackDevices              PlaybackDevice[]
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  ThreatIntelligenceIncident   ThreatIntelligenceIncident[]
  ThreatPattern                ThreatPattern[]
  ThreatPrediction             ThreatPrediction[]
  RealtimeThreatEvent          RealtimeThreatEvent[]
  RealtimeIncidentNotification RealtimeIncidentNotification[]
  evidenceRecords              EvidenceRecord[]
  investigationCases           InvestigationCase[]
  threatIntelCampaigns         ThreatIntelCampaign[]
  threatIntelMatches           ThreatIntelMatch[]

  @@index([name])
  @@index([permanentQrCode])
}

model Screen {
  id              String           @id @default(uuid())
  theatreId       String
  theatre         Theatre          @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  screenNumber    Int
  name            String
  capacity        Int
  shows           Show[]
  movieReleases   MovieRelease[]
  playbackDevices PlaybackDevice[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([theatreId, screenNumber])
  @@index([theatreId])
}

model Movie {
  id                           String                         @id @default(uuid())
  title                        String
  description                  String?
  synopsis                     String?
  durationMinutes              Int
  language                     String
  rating                       String?
  posterUrl                    String?
  releaseDate                  DateTime?
  contentStatus                ContentStatus                  @default(DRAFT)
  productionCompanyId          String?
  productionCompany            ProductionCompany?             @relation(fields: [productionCompanyId], references: [id], onDelete: SetNull)
  assets                       ContentAsset[]
  videoAssets                  VideoAsset[]
  releases                     MovieRelease[]
  audits                       MovieAuditEvent[]
  shows                        Show[]
  incidents                    PiracyIncident[]
  securityIncidents            SecurityIncident[]
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  ThreatPattern                ThreatPattern[]
  ThreatPrediction             ThreatPrediction[]
  RealtimeThreatEvent          RealtimeThreatEvent[]
  RealtimeIncidentNotification RealtimeIncidentNotification[]
  evidenceRecords              EvidenceRecord[]
  investigationCases           InvestigationCase[]
  threatIntelCampaigns         ThreatIntelCampaign[]
  threatIntelMatches           ThreatIntelMatch[]

  @@index([title])
  @@index([productionCompanyId])
  @@index([contentStatus])
}

model ContentAsset {
  id               String       @id @default(uuid())
  movieId          String
  movie            Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  assetType        String
  processingStatus String       @default("READY")
  durationMinutes  Int?
  resolution       String?
  fileReference    String
  fileSizeMb       Int?
  videoAssets      VideoAsset[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([movieId])
  @@index([assetType])
}

model MovieRelease {
  id                  String            @id @default(uuid())
  movieId             String
  movie               Movie             @relation(fields: [movieId], references: [id], onDelete: Cascade)
  productionCompanyId String
  productionCompany   ProductionCompany @relation(fields: [productionCompanyId], references: [id], onDelete: Cascade)
  theatreId           String
  theatre             Theatre           @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  screenId            String?
  screen              Screen?           @relation(fields: [screenId], references: [id], onDelete: SetNull)
  startDate           DateTime
  endDate             DateTime
  status              ReleaseStatus     @default(PENDING_APPROVAL)
  rejectionReason     String?
  approvedByAdminId   String?
  approvedAt          DateTime?
  audits              MovieAuditEvent[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([movieId])
  @@index([productionCompanyId])
  @@index([theatreId])
  @@index([screenId])
  @@index([status])
  @@index([startDate, endDate])
}

model MovieAuditEvent {
  id        String        @id @default(uuid())
  movieId   String?
  movie     Movie?        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  releaseId String?
  release   MovieRelease? @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  details   String?
  createdAt DateTime      @default(now())

  @@index([movieId])
  @@index([releaseId])
  @@index([action])
  @@index([createdAt])
}

model Show {
  id                           String                         @id @default(uuid())
  theatreId                    String
  theatre                      Theatre                        @relation(fields: [theatreId], references: [id], onDelete: Restrict)
  screenId                     String
  screen                       Screen                         @relation(fields: [screenId], references: [id], onDelete: Restrict)
  movieId                      String
  movie                        Movie                          @relation(fields: [movieId], references: [id], onDelete: Restrict)
  startTime                    DateTime
  endTime                      DateTime
  status                       ShowStatus                     @default(SCHEDULED)
  tickets                      Ticket[]
  verifications                Verification[]
  protectionEvents             ProtectionEvent[]
  playbackSessions             PlaybackSession[]
  drmLicenses                  DrmLicense[]
  incidents                    PiracyIncident[]
  securityIncidents            SecurityIncident[]
  threatAlerts                 ThreatAlert[]
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  ThreatIntelligenceIncident   ThreatIntelligenceIncident[]
  ThreatPattern                ThreatPattern[]
  ThreatPrediction             ThreatPrediction[]
  RealtimeThreatEvent          RealtimeThreatEvent[]
  RealtimeIncidentNotification RealtimeIncidentNotification[]
  evidenceRecords              EvidenceRecord[]
  investigationCases           InvestigationCase[]

  @@index([theatreId])
  @@index([screenId])
  @@index([movieId])
  @@index([startTime, status])
}

model Ticket {
  id           String       @id @default(uuid())
  ticketNumber String       @unique
  showId       String
  show         Show         @relation(fields: [showId], references: [id], onDelete: Cascade)
  seatNumber   String
  price        Decimal      @db.Decimal(10, 2)
  status       TicketStatus @default(ISSUED)
  activation   Activation?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([showId])
  @@index([ticketNumber])
  @@index([status])
}

model Activation {
  id                         String                       @id @default(uuid())
  ticketId                   String                       @unique
  ticket                     Ticket                       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  activationCode             String                       @unique
  status                     ActivationStatus             @default(PENDING)
  activatedAt                DateTime?
  expiresAt                  DateTime?
  deviceFingerprint          String?
  ipAddress                  String?
  verifications              Verification[]
  protectionEvents           ProtectionEvent[]
  playbackSessions           PlaybackSession[]
  drmLicenses                DrmLicense[]
  incidents                  PiracyIncident[]
  securityIncidents          SecurityIncident[]
  threatAlerts               ThreatAlert[]
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  ThreatIntelligenceIncident ThreatIntelligenceIncident[]

  @@index([activationCode])
  @@index([status])
}

model Verification {
  id           String             @id @default(uuid())
  activationId String?
  activation   Activation?        @relation(fields: [activationId], references: [id], onDelete: SetNull)
  theatreId    String?
  theatre      Theatre?           @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  showId       String?
  show         Show?              @relation(fields: [showId], references: [id], onDelete: SetNull)
  staffId      String
  staff        User               @relation(fields: [staffId], references: [id], onDelete: Restrict)
  result       VerificationResult
  reason       String?
  scannedCode  String?
  createdAt    DateTime           @default(now())

  @@index([activationId])
  @@index([theatreId])
  @@index([showId])
  @@index([staffId])
  @@index([result])
  @@index([createdAt])
}

model ProtectionEvent {
  id           String              @id @default(uuid())
  activationId String
  activation   Activation          @relation(fields: [activationId], references: [id], onDelete: Cascade)
  theatreId    String?
  theatre      Theatre?            @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  showId       String?
  show         Show?               @relation(fields: [showId], references: [id], onDelete: SetNull)
  eventType    ProtectionEventType
  metadata     String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime            @default(now())

  @@index([activationId])
  @@index([theatreId])
  @@index([showId])
  @@index([eventType])
  @@index([createdAt])
}

model VideoAsset {
  id                    String            @id @default(uuid())
  title                 String
  movieId               String
  movie                 Movie             @relation(fields: [movieId], references: [id], onDelete: Cascade)
  contentAssetId        String?
  contentAsset          ContentAsset?     @relation(fields: [contentAssetId], references: [id], onDelete: SetNull)
  productionCompanyId   String
  productionCompany     ProductionCompany @relation(fields: [productionCompanyId], references: [id], onDelete: Cascade)
  state                 VideoAssetState   @default(READY)
  processingStatus      ProcessingStatus  @default(QUEUED)
  processingProgress    Int               @default(0)
  processingError       String?
  processingLogs        String?
  sourceFilePath        String?
  originalFilename      String?
  fileSizeMb            Float?
  mimeType              String?
  resolution            String?
  durationSeconds       Int?              @default(0)
  videoCodec            String?
  audioCodec            String?
  streamKey             String            @unique
  deliveryManifestUrl   String
  hlsMasterManifestPath String?
  thumbnailPath         String?
  drmScheme             String?           @default("AES-128-ENCRYPTED")
  bitrates              String?           @default("1080p, 720p, 480p")
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  playbackSessions      PlaybackSession[]
  drmAsset              DrmAsset?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([movieId])
  @@index([productionCompanyId])
  @@index([state])
  @@index([processingStatus])
  @@index([streamKey])
}

model PlaybackSession {
  id                         String                       @id @default(uuid())
  sessionToken               String                       @unique
  activationId               String
  activation                 Activation                   @relation(fields: [activationId], references: [id], onDelete: Cascade)
  videoAssetId               String
  videoAsset                 VideoAsset                   @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  theatreId                  String
  theatre                    Theatre                      @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  showId                     String
  show                       Show                         @relation(fields: [showId], references: [id], onDelete: Cascade)
  status                     PlaybackSessionStatus        @default(AUTHORIZED)
  ipAddress                  String?
  userAgent                  String?
  authorizedAt               DateTime                     @default(now())
  expiresAt                  DateTime
  terminatedAt               DateTime?
  terminationReason          String?
  lastHeartbeatAt            DateTime?
  drmLicenses                DrmLicense[]
  incidents                  PiracyIncident[]
  securityIncidents          SecurityIncident[]
  threatAlerts               ThreatAlert[]
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  ThreatIntelligenceIncident ThreatIntelligenceIncident[]
  evidenceRecords            EvidenceRecord[]
  investigationCases         InvestigationCase[]
  threatIntelMatches         ThreatIntelMatch[]

  @@index([sessionToken])
  @@index([activationId])
  @@index([videoAssetId])
  @@index([theatreId])
  @@index([showId])
  @@index([status])
  @@index([expiresAt])
  @@index([theatreId, status])
  @@index([showId, status])
}

model DrmAsset {
  id                   String          @id @default(uuid())
  videoAssetId         String          @unique
  videoAsset           VideoAsset      @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  provider             DrmProviderType @default(MOCK)
  drmScheme            String          @default("AES-128-ENCRYPTED")
  keyId                String          @unique
  encryptedManifestUrl String?
  licenseServerUrl     String?
  status               DrmStatus       @default(NOT_CONFIGURED)
  statusMessage        String?
  encryptionProgress   Int             @default(0)
  metadata             String?
  licenses             DrmLicense[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([videoAssetId])
  @@index([keyId])
  @@index([provider])
  @@index([status])
}

model DrmLicense {
  id                String           @id @default(uuid())
  drmAssetId        String
  drmAsset          DrmAsset         @relation(fields: [drmAssetId], references: [id], onDelete: Cascade)
  playbackSessionId String?
  playbackSession   PlaybackSession? @relation(fields: [playbackSessionId], references: [id], onDelete: SetNull)
  activationId      String
  activation        Activation       @relation(fields: [activationId], references: [id], onDelete: Cascade)
  theatreId         String
  theatre           Theatre          @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  showId            String
  show              Show             @relation(fields: [showId], references: [id], onDelete: Cascade)
  licenseToken      String           @unique
  status            DrmLicenseStatus @default(ISSUED)
  issuedAt          DateTime         @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revocationReason  String?
  clientIp          String?
  userAgent         String?
  deviceFingerprint String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([drmAssetId])
  @@index([playbackSessionId])
  @@index([activationId])
  @@index([theatreId])
  @@index([showId])
  @@index([licenseToken])
  @@index([status])
  @@index([expiresAt])
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  ROLE_ACCESS_DENIED
  TICKET_CREATED
  TICKET_CANCELLED
  QR_ACTIVATION
  QR_ACTIVATION_DENIED
  STAFF_VERIFICATION
  PLAYBACK_AUTHORIZED
  PLAYBACK_DENIED
  PLAYBACK_TERMINATED
  DRM_LICENSE_AUTHORIZED
  DRM_LICENSE_DENIED
  DRM_LICENSE_REVOKED
  SUSPICIOUS_ACTIVITY
  RATE_LIMIT_EXCEEDED
}

enum SecuritySeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SecurityAuditLog {
  id                String            @id @default(uuid())
  eventType         SecurityEventType
  severity          SecuritySeverity  @default(INFO)
  userId            String?
  actorEmail        String?
  actorRole         String?
  theatreId         String?
  showId            String?
  activationId      String?
  ticketId          String?
  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?
  endpoint          String?
  actionSummary     String
  metadata          String?
  isThreat          Boolean           @default(false)
  threatDetails     String?
  createdAt         DateTime          @default(now())

  @@index([eventType])
  @@index([severity])
  @@index([userId])
  @@index([theatreId])
  @@index([showId])
  @@index([activationId])
  @@index([isThreat])
  @@index([createdAt])
  @@index([ipAddress])
}

model RevokedToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  revokedAt DateTime @default(now())
  expiresAt DateTime
  reason    String?

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
}

enum IncidentStatus {
  DETECTED
  TRIAGED
  INVESTIGATING
  CONFIRMED
  MITIGATED
  CLOSED
  FALSE_POSITIVE
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceType {
  WATERMARK_CAPTURE
  SCREENSHOT_ATTEMPT
  TOKEN_REPLAY
  GEO_MISMATCH
  DRM_TAMPER
  AUDIO_LEAK
  SUSPICIOUS_HEURISTIC
}

model PiracyIncident {
  id                     String                      @id @default(uuid())
  incidentNumber         String                      @unique
  title                  String
  description            String?
  severity               IncidentSeverity            @default(MEDIUM)
  status                 IncidentStatus              @default(DETECTED)
  theatreId              String?
  theatre                Theatre?                    @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  showId                 String?
  show                   Show?                       @relation(fields: [showId], references: [id], onDelete: SetNull)
  movieId                String?
  movie                  Movie?                      @relation(fields: [movieId], references: [id], onDelete: SetNull)
  playbackSessionId      String?
  playbackSession        PlaybackSession?            @relation(fields: [playbackSessionId], references: [id], onDelete: SetNull)
  activationId           String?
  activation             Activation?                 @relation(fields: [activationId], references: [id], onDelete: SetNull)
  riskScore              Int                         @default(50)
  assignedInvestigatorId String?
  assignedInvestigator   User?                       @relation(fields: [assignedInvestigatorId], references: [id], onDelete: SetNull)
  mitigationAction       String?
  resolutionNotes        String?
  evidence               ForensicEvidence[]
  notes                  ForensicInvestigationNote[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  closedAt               DateTime?

  @@index([incidentNumber])
  @@index([status])
  @@index([severity])
  @@index([theatreId])
  @@index([showId])
  @@index([movieId])
  @@index([playbackSessionId])
  @@index([activationId])
  @@index([riskScore])
  @@index([createdAt])
}

model ForensicEvidence {
  id                   String         @id @default(uuid())
  incidentId           String
  incident             PiracyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  evidenceType         EvidenceType   @default(WATERMARK_CAPTURE)
  watermarkFingerprint String?
  playbackSessionId    String?
  activationId         String?
  theatreId            String?
  showId               String?
  seatNumber           String?
  confidenceScore      Int            @default(90)
  evidenceHash         String
  sourceUrlOrFile      String?
  metadata             String?
  detectedAt           DateTime       @default(now())
  createdAt            DateTime       @default(now())

  @@index([incidentId])
  @@index([watermarkFingerprint])
  @@index([playbackSessionId])
  @@index([activationId])
  @@index([evidenceType])
  @@index([evidenceHash])
  @@index([createdAt])
}

model ForensicInvestigationNote {
  id                String         @id @default(uuid())
  incidentId        String
  incident          PiracyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  investigatorId    String?
  investigatorEmail String?
  note              String
  createdAt         DateTime       @default(now())

  @@index([incidentId])
  @@index([investigatorId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// PHASE 14: REAL-TIME COMMAND CENTER & INCIDENT RESPONSE AUTOMATION
// -------------------------------------------------------------

enum SecurityIncidentStatus {
  NEW
  OPEN
  DETECTED
  TRIAGED
  ACKNOWLEDGED
  INVESTIGATING
  CONTAINMENT_PENDING
  CONTAINED
  MONITORING
  ESCALATED
  RESOLVED
  CLOSED
}

enum IncidentSource {
  SYSTEM_ALERT
  OPERATOR_REPORT
  THREAT_ENGINE
  FORENSIC_MATCH
  THREAT_INTEL
  EVIDENCE_INTEGRITY
  ZERO_TRUST_ENGINE
}

enum IncidentEvidenceType {
  WATERMARK
  LOG_EXTRACT
  DEVICE_FINGERPRINT
  GEO_TRACE
  DRM_LICENSE_RECORD
  SCREENSHOT_CAPTURE
  EVIDENCE_VAULT_ITEM
  THREAT_IOC
}

enum IncidentActionType {
  SESSION_REVOKED
  ACTIVATION_REVOKED
  DRM_REVOKED
  TOKEN_BLACKLISTED
  PLAYBACK_DISABLED
  SEVERITY_ESCALATED
  NOTIFICATION_SENT
  INVESTIGATION_CREATED
  STATUS_CHANGED
  ANALYST_ASSIGNED
  CONTAINMENT_INITIATED
  RESOLVED
}

enum ThreatAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model SecurityIncident {
  id                     String                     @id @default(uuid())
  incidentNumber         String                     @unique
  title                  String
  description            String?
  severity               IncidentSeverity           @default(MEDIUM)
  status                 SecurityIncidentStatus     @default(NEW)
  source                 IncidentSource             @default(THREAT_ENGINE)
  assignedToId           String?
  assignedTo             User?                      @relation("AssignedSecurityIncidents", fields: [assignedToId], references: [id], onDelete: SetNull)
  theatreId              String?
  theatre                Theatre?                   @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  showId                 String?
  show                   Show?                      @relation(fields: [showId], references: [id], onDelete: SetNull)
  movieId                String?
  movie                  Movie?                     @relation(fields: [movieId], references: [id], onDelete: SetNull)
  activationId           String?
  activation             Activation?                @relation(fields: [activationId], references: [id], onDelete: SetNull)
  playbackSessionId      String?
  playbackSession        PlaybackSession?           @relation(fields: [playbackSessionId], references: [id], onDelete: SetNull)
  investigationCaseId    String?
  evidenceRecordId       String?
  threatIntelIndicatorId String?
  riskScore              Int                        @default(50)
  evidenceItems          IncidentEvidence[]
  actions                IncidentAction[]
  timeline               SecurityIncidentTimeline[]
  escalations            SecurityEscalation[]
  detectedAt             DateTime                   @default(now())
  acknowledgedAt         DateTime?
  resolvedAt             DateTime?
  resolutionNotes        String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([incidentNumber])
  @@index([status])
  @@index([severity])
  @@index([theatreId])
  @@index([showId])
  @@index([activationId])
  @@index([playbackSessionId])
  @@index([riskScore])
  @@index([createdAt])
}

model IncidentEvidence {
  id           String               @id @default(uuid())
  incidentId   String
  incident     SecurityIncident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  evidenceType IncidentEvidenceType @default(LOG_EXTRACT)
  referenceId  String?
  metadata     String?
  hash         String
  capturedAt   DateTime             @default(now())

  @@index([incidentId])
  @@index([evidenceType])
  @@index([hash])
  @@index([capturedAt])
}

model IncidentAction {
  id         String             @id @default(uuid())
  incidentId String
  incident   SecurityIncident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actionType IncidentActionType
  actorId    String?
  targetId   String?
  result     String             @default("SUCCESS")
  metadata   String?
  createdAt  DateTime           @default(now())

  @@index([incidentId])
  @@index([actionType])
  @@index([actorId])
  @@index([createdAt])
}

model ThreatAlert {
  id                String            @id @default(uuid())
  alertType         String
  severity          IncidentSeverity  @default(MEDIUM)
  riskScore         Int               @default(50)
  theatreId         String?
  theatre           Theatre?          @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  showId            String?
  show              Show?             @relation(fields: [showId], references: [id], onDelete: SetNull)
  activationId      String?
  activation        Activation?       @relation(fields: [activationId], references: [id], onDelete: SetNull)
  playbackSessionId String?
  playbackSession   PlaybackSession?  @relation(fields: [playbackSessionId], references: [id], onDelete: SetNull)
  description       String
  status            ThreatAlertStatus @default(ACTIVE)
  detectedAt        DateTime          @default(now())
  resolvedAt        DateTime?

  @@index([alertType])
  @@index([severity])
  @@index([status])
  @@index([theatreId])
  @@index([showId])
  @@index([activationId])
  @@index([playbackSessionId])
  @@index([riskScore])
  @@index([detectedAt])
}

// -------------------------------------------------------------
// PHASE 15: PRODUCTION CLOUD & THEATRE PLAYBACK DEVICE READINESS
// -------------------------------------------------------------

enum DeviceStatus {
  REGISTERED
  ACTIVE
  OFFLINE
  BLOCKED
  RETIRED
}

model PlaybackDevice {
  id                String       @id @default(uuid())
  deviceId          String       @unique
  name              String
  status            DeviceStatus @default(REGISTERED)
  theatreId         String
  theatre           Theatre      @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  screenId          String?
  screen            Screen?      @relation(fields: [screenId], references: [id], onDelete: SetNull)
  softwareVersion   String       @default("2.4.0")
  deviceFingerprint String?
  ipAddress         String?
  lastHeartbeatAt   DateTime?
  registeredAt      DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([deviceId])
  @@index([theatreId])
  @@index([screenId])
  @@index([status])
  @@index([lastHeartbeatAt])
}

// -------------------------------------------------------------
// PHASE 16: DISTRIBUTED IDEMPOTENCY & TRAFFIC ENGINEERING
// -------------------------------------------------------------

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}

model IdempotencyRecord {
  id           String            @id @default(uuid())
  key          String            @unique
  path         String
  method       String
  requestHash  String
  status       IdempotencyStatus @default(PENDING)
  statusCode   Int?
  responseBody String?
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([key])
  @@index([status])
  @@index([expiresAt])
}

// -------------------------------------------------------------
// ANTI-PIRACY INTELLIGENCE LAYER & AUTOMATED RESPONSE
// -------------------------------------------------------------

model ThreatIntelligenceIncident {
  id                String                    @id @default(uuid())
  incidentCode      String                    @unique
  title             String
  description       String
  severity          IncidentSeverity          @default(MEDIUM)
  riskScore         Int                       @default(0)
  confidenceScore   Int                       @default(0)
  status            IncidentStatus            @default(DETECTED)
  source            String                    @default("INTELLIGENCE_CORRELATOR")
  theatreId         String?
  theatre           Theatre?                  @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  showId            String?
  show              Show?                     @relation(fields: [showId], references: [id], onDelete: SetNull)
  activationId      String?
  activation        Activation?               @relation(fields: [activationId], references: [id], onDelete: SetNull)
  playbackSessionId String?
  playbackSession   PlaybackSession?          @relation(fields: [playbackSessionId], references: [id], onDelete: SetNull)
  firstDetectedAt   DateTime                  @default(now())
  lastDetectedAt    DateTime                  @default(now())
  resolvedAt        DateTime?
  assignedTo        String?
  signals           ThreatSignal[]
  correlations      ThreatCorrelation[]
  actions           AutomatedResponseAction[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([incidentCode])
  @@index([severity])
  @@index([status])
  @@index([theatreId])
  @@index([showId])
  @@index([riskScore])
  @@index([lastDetectedAt])
}

model ThreatSignal {
  id          String                      @id @default(uuid())
  incidentId  String?
  incident    ThreatIntelligenceIncident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  patternId   String?
  pattern     ThreatPattern?              @relation(fields: [patternId], references: [id], onDelete: Cascade)
  signalType  String
  signalValue String
  eventType   String?
  source      String?
  riskWeight  Int                         @default(10)
  weight      Int                         @default(10)
  confidence  Int                         @default(80)
  metadata    String?
  detectedAt  DateTime                    @default(now())
  createdAt   DateTime                    @default(now())

  @@index([incidentId])
  @@index([patternId])
  @@index([signalType])
  @@index([detectedAt])
}

model ThreatCorrelation {
  id               String                     @id @default(uuid())
  incidentId       String
  incident         ThreatIntelligenceIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  sourceEventId    String
  sourceType       String
  correlationType  String
  correlationScore Int                        @default(75)
  createdAt        DateTime                   @default(now())

  @@index([incidentId])
  @@index([sourceEventId])
  @@index([correlationType])
}

model AutomatedResponseAction {
  id         String                     @id @default(uuid())
  incidentId String
  incident   ThreatIntelligenceIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actionType String
  status     String                     @default("RECOMMENDED")
  reason     String
  executedBy String?
  executedAt DateTime?
  expiresAt  DateTime?
  metadata   String?
  createdAt  DateTime                   @default(now())

  @@index([incidentId])
  @@index([actionType])
  @@index([status])
}

model IntelligenceSnapshot {
  id                 String   @id @default(uuid())
  totalThreats       Int      @default(0)
  criticalThreats    Int      @default(0)
  highThreats        Int      @default(0)
  activeIncidents    Int      @default(0)
  affectedTheatres   Int      @default(0)
  affectedShows      Int      @default(0)
  suspiciousSessions Int      @default(0)
  averageRiskScore   Float    @default(0.0)
  generatedAt        DateTime @default(now())

  @@index([generatedAt])
}

// -------------------------------------------------------------
// PREDICTIVE THREAT INTELLIGENCE & PATTERN RECOGNITION
// -------------------------------------------------------------

model ThreatRiskScore {
  id                  String   @id @default(uuid())
  entityType          String // "THEATRE" | "SHOW" | "MOVIE" | "SESSION" | "OVERALL"
  entityId            String?
  riskScore           Int // 0 - 100
  riskLevel           String // "LOW" | "GUARDED" | "ELEVATED" | "HIGH" | "CRITICAL"
  confidence          Int // 0 - 100
  contributingSignals String // JSON string
  recommendation      String
  calculatedAt        DateTime @default(now())
  expiresAt           DateTime

  @@index([entityType, entityId])
  @@index([riskScore])
  @@index([calculatedAt])
  @@index([expiresAt])
}

model ThreatPattern {
  id              String                    @id @default(uuid())
  patternType     String
  name            String
  description     String
  severity        IncidentSeverity          @default(MEDIUM)
  confidence      Int                       @default(80)
  occurrenceCount Int                       @default(1)
  theatreId       String?
  theatre         Theatre?                  @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  showId          String?
  show            Show?                     @relation(fields: [showId], references: [id], onDelete: SetNull)
  movieId         String?
  movie           Movie?                    @relation(fields: [movieId], references: [id], onDelete: SetNull)
  evidence        String?
  status          String                    @default("DETECTED")
  firstDetectedAt DateTime                  @default(now())
  lastDetectedAt  DateTime                  @default(now())
  signals         ThreatSignal[]
  links           ThreatInvestigationLink[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([patternType])
  @@index([severity])
  @@index([status])
  @@index([theatreId])
  @@index([showId])
  @@index([movieId])
  @@index([lastDetectedAt])
}

model ThreatPrediction {
  id                String                    @id @default(uuid())
  theatreId         String?
  theatre           Theatre?                  @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  showId            String?
  show              Show?                     @relation(fields: [showId], references: [id], onDelete: SetNull)
  movieId           String?
  movie             Movie?                    @relation(fields: [movieId], references: [id], onDelete: SetNull)
  predictionType    String
  predictedRisk     Int // 0 - 100
  confidence        Int // 0 - 100
  explanation       String
  recommendedAction String
  predictionWindow  String                    @default("NEXT_24_HOURS")
  links             ThreatInvestigationLink[]
  createdAt         DateTime                  @default(now())

  @@index([theatreId])
  @@index([showId])
  @@index([movieId])
  @@index([predictedRisk])
  @@index([createdAt])
}

model ThreatInvestigationLink {
  id                 String            @id @default(uuid())
  predictionId       String?
  prediction         ThreatPrediction? @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  patternId          String?
  pattern            ThreatPattern?    @relation(fields: [patternId], references: [id], onDelete: Cascade)
  incidentId         String?
  investigationId    String?
  forensicEvidenceId String?
  notes              String?
  createdAt          DateTime          @default(now())

  @@index([predictionId])
  @@index([patternId])
  @@index([incidentId])
  @@index([investigationId])
}

// -------------------------------------------------------------
// PHASE 16: REAL-TIME ANTI-PIRACY INTELLIGENCE & SOC RESPONSE
// -------------------------------------------------------------

model RealtimeThreatEvent {
  id                String           @id @default(uuid())
  correlationId     String
  eventId           String           @unique
  eventType         String
  source            String
  severity          IncidentSeverity @default(LOW)
  theatreId         String?
  theatre           Theatre?         @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  showId            String?
  show              Show?            @relation(fields: [showId], references: [id], onDelete: SetNull)
  movieId           String?
  movie             Movie?           @relation(fields: [movieId], references: [id], onDelete: SetNull)
  activationId      String?
  playbackSessionId String?
  metadata          String? // Sanitized JSON payload (no secrets)
  createdAt         DateTime         @default(now())

  @@index([correlationId])
  @@index([severity])
  @@index([eventType])
  @@index([theatreId])
  @@index([showId])
  @@index([movieId])
  @@index([createdAt])
}

model RiskHistory {
  id            String   @id @default(uuid())
  entityType    String // "THEATRE" | "SHOW" | "MOVIE" | "SESSION" | "OVERALL"
  entityId      String?
  previousScore Int
  newScore      Int
  reason        String
  correlationId String?
  calculatedAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([calculatedAt])
  @@index([correlationId])
}

model AutomatedResponse {
  id            String    @id @default(uuid())
  incidentId    String?
  actionType    String // "REVOKE_PLAYBACK_SESSION" | "REVOKE_DRM_LICENSE" | "REVOKE_ACTIVATION" | "BLACKLIST_TOKEN" | "ESCALATE_INCIDENT" | "START_INVESTIGATION"
  status        String    @default("RECOMMENDED") // "RECOMMENDED" | "APPROVED" | "REJECTED" | "EXECUTED"
  targetId      String?
  reason        String
  executedBy    String?
  executedAt    DateTime?
  correlationId String?
  result        String?
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([incidentId])
  @@index([actionType])
  @@index([status])
  @@index([correlationId])
  @@index([createdAt])
}

model RealtimeIncidentNotification {
  id               String           @id @default(uuid())
  incidentId       String?
  notificationType String
  severity         IncidentSeverity @default(HIGH)
  message          String
  theatreId        String?
  theatre          Theatre?         @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  showId           String?
  show             Show?            @relation(fields: [showId], references: [id], onDelete: SetNull)
  movieId          String?
  movie            Movie?           @relation(fields: [movieId], references: [id], onDelete: SetNull)
  isRead           Boolean          @default(false)
  sentAt           DateTime         @default(now())
  createdAt        DateTime         @default(now())

  @@index([severity])
  @@index([isRead])
  @@index([sentAt])
  @@index([theatreId])
  @@index([showId])
  @@index([movieId])
}

// ==========================================
// PHASE 17: GLOBAL FORENSIC EVIDENCE, CASE MANAGEMENT & COMPLIANCE
// ==========================================

enum EvidenceClassification {
  WATERMARK_MATCH
  PLAYBACK_ANOMALY
  QR_ABUSE
  DRM_TAMPER
  AUTH_ATTACK
  THREAT_INTEL
  SCREENSHOT_CAPTURE
  AUDIO_LEAK
}

enum EvidenceStatus {
  COLLECTED
  VERIFIED
  FLAGGED_TAMPERED
  ARCHIVED
  LEGAL_HOLD
}

enum RetentionStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  LEGAL_HOLD
  ARCHIVED
}

enum InvestigationCaseStatus {
  OPEN
  TRIAGED
  INVESTIGATING
  CONTAINED
  ESCALATED
  RESOLVED
  CLOSED
  ARCHIVED
}

enum InvestigationCaseSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model EvidenceRecord {
  id                   String                      @id @default(uuid())
  evidenceNumber       String                      @unique
  title                String
  description          String?
  classification       EvidenceClassification
  severity             IncidentSeverity            @default(MEDIUM)
  status               EvidenceStatus              @default(COLLECTED)
  retentionStatus      RetentionStatus             @default(ACTIVE)
  theatreId            String?
  theatre              Theatre?                    @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  showId               String?
  show                 Show?                       @relation(fields: [showId], references: [id], onDelete: SetNull)
  movieId              String?
  movie                Movie?                      @relation(fields: [movieId], references: [id], onDelete: SetNull)
  productionCompanyId  String?
  productionCompany    ProductionCompany?          @relation(fields: [productionCompanyId], references: [id], onDelete: SetNull)
  playbackSessionId    String?
  playbackSession      PlaybackSession?            @relation(fields: [playbackSessionId], references: [id], onDelete: SetNull)
  incidentId           String?
  securityIncidentId   String?
  source               String
  capturedBy           String?
  metadata             String? // Sanitized JSON string (zero-secret / zero-PII)
  integrityHash        String? // Current SHA-256 hash
  lastVerifiedAt       DateTime?
  retentionExpiresAt   DateTime?
  legalHoldReason      String?
  artifacts            EvidenceArtifact[]
  hashes               EvidenceHash[]
  chainEvents          EvidenceChainEvent[]
  accessLogs           EvidenceAccessLog[]
  investigationLinks   InvestigationEvidenceLink[]
  threatIntelCampaigns ThreatIntelCampaign[]
  threatIntelMatches   ThreatIntelMatch[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([evidenceNumber])
  @@index([classification])
  @@index([severity])
  @@index([status])
  @@index([retentionStatus])
  @@index([theatreId])
  @@index([showId])
  @@index([movieId])
  @@index([productionCompanyId])
  @@index([createdAt])
}

model EvidenceArtifact {
  id               String         @id @default(uuid())
  evidenceRecordId String
  evidenceRecord   EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  artifactName     String
  artifactType     String // "WATERMARK_TAG", "SCREENSHOT", "LOG_SNIPPET", "TELEMETRY_DUMP", "AUDIO_PRINT", "DRM_PAYLOAD"
  mimeType         String         @default("application/json")
  fileSizeBytes    Int            @default(0)
  storagePath      String?
  sha256Hash       String
  payloadData      String? // Sanitized non-PII payload data
  createdAt        DateTime       @default(now())

  @@index([evidenceRecordId])
  @@index([artifactType])
  @@index([sha256Hash])
  @@index([createdAt])
}

model EvidenceHash {
  id                 String         @id @default(uuid())
  evidenceRecordId   String
  evidenceRecord     EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  calculatedHash     String
  previousHash       String?
  algorithm          String         @default("SHA-256")
  verificationStatus String         @default("VALID") // "VALID" | "TAMPERED"
  verifiedAt         DateTime       @default(now())

  @@index([evidenceRecordId])
  @@index([verificationStatus])
  @@index([verifiedAt])
}

model EvidenceChainEvent {
  id                String         @id @default(uuid())
  evidenceRecordId  String
  evidenceRecord    EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  eventType         String // "ACQUISITION", "INTEGRITY_CHECK", "ANALYST_ACCESS", "LEGAL_HOLD_APPLIED", "STATUS_CHANGE", "EXPORT"
  actorId           String?
  actorRole         String?
  actorEmail        String?
  previousChainHash String
  currentChainHash  String
  eventData         String? // Sanitized event metadata
  timestamp         DateTime       @default(now())

  @@index([evidenceRecordId])
  @@index([eventType])
  @@index([timestamp])
}

model EvidenceAccessLog {
  id               String         @id @default(uuid())
  evidenceRecordId String
  evidenceRecord   EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  userId           String
  userEmail        String
  userRole         String
  accessType       String // "VIEW", "VERIFY", "EXPORT", "HOLD", "NOTE"
  ipAddress        String?
  reason           String?
  accessedAt       DateTime       @default(now())

  @@index([evidenceRecordId])
  @@index([userId])
  @@index([userRole])
  @@index([accessType])
  @@index([accessedAt])
}

model InvestigationCase {
  id                   String                       @id @default(uuid())
  caseNumber           String                       @unique
  title                String
  description          String?
  status               InvestigationCaseStatus      @default(OPEN)
  severity             InvestigationCaseSeverity    @default(MEDIUM)
  threatClassification String? // e.g. "PLAYBACK_PIRACY_ACTIVITY"
  theatreId            String?
  theatre              Theatre?                     @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  showId               String?
  show                 Show?                        @relation(fields: [showId], references: [id], onDelete: SetNull)
  movieId              String?
  movie                Movie?                       @relation(fields: [movieId], references: [id], onDelete: SetNull)
  productionCompanyId  String?
  productionCompany    ProductionCompany?           @relation(fields: [productionCompanyId], references: [id], onDelete: SetNull)
  playbackSessionId    String?
  playbackSession      PlaybackSession?             @relation(fields: [playbackSessionId], references: [id], onDelete: SetNull)
  assignedAnalystId    String?
  assignedAnalyst      User?                        @relation("AssignedCases", fields: [assignedAnalystId], references: [id], onDelete: SetNull)
  resolution           String?
  closureReason        String?
  closedAt             DateTime?
  assignments          InvestigationAssignment[]
  notes                InvestigationNote[]
  evidenceLinks        InvestigationEvidenceLink[]
  timelineEvents       InvestigationTimelineEvent[]
  statusHistory        InvestigationStatusHistory[]
  threatIntelCampaigns ThreatIntelCampaign[]
  threatIntelMatches   ThreatIntelMatch[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([caseNumber])
  @@index([status])
  @@index([severity])
  @@index([theatreId])
  @@index([showId])
  @@index([movieId])
  @@index([productionCompanyId])
  @@index([assignedAnalystId])
  @@index([createdAt])
}

model InvestigationAssignment {
  id         String            @id @default(uuid())
  caseId     String
  case       InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  analystId  String
  analyst    User              @relation(fields: [analystId], references: [id], onDelete: Cascade)
  assignedBy String
  assignedAt DateTime          @default(now())
  notes      String?

  @@index([caseId])
  @@index([analystId])
  @@index([assignedAt])
}

model InvestigationNote {
  id         String            @id @default(uuid())
  caseId     String
  case       InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId   String
  author     User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  isInternal Boolean           @default(true)
  createdAt  DateTime          @default(now())

  @@index([caseId])
  @@index([authorId])
  @@index([createdAt])
}

model InvestigationEvidenceLink {
  id               String            @id @default(uuid())
  caseId           String
  case             InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidenceRecordId String
  evidenceRecord   EvidenceRecord    @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  linkedBy         String
  linkedAt         DateTime          @default(now())
  relevance        String?

  @@unique([caseId, evidenceRecordId])
  @@index([caseId])
  @@index([evidenceRecordId])
  @@index([linkedAt])
}

model InvestigationTimelineEvent {
  id          String            @id @default(uuid())
  caseId      String
  case        InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  eventType   String // "STATUS_CHANGE", "EVIDENCE_ATTACHED", "CONTAINMENT_TRIGGERED", "NOTE_ADDED"
  actorId     String?
  timestamp   DateTime          @default(now())

  @@index([caseId])
  @@index([eventType])
  @@index([timestamp])
}

model InvestigationStatusHistory {
  id         String                  @id @default(uuid())
  caseId     String
  case       InvestigationCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStatus InvestigationCaseStatus
  toStatus   InvestigationCaseStatus
  changedBy  String
  reason     String?
  changedAt  DateTime                @default(now())

  @@index([caseId])
  @@index([fromStatus])
  @@index([toStatus])
  @@index([changedAt])
}

// ==========================================
// PHASE 18: EXTERNAL THREAT INTELLIGENCE
// ==========================================

enum ThreatIntelIndicatorType {
  IP_ADDRESS
  DOMAIN
  URL
  FILE_HASH
  EMAIL
  CERTIFICATE
  USER_AGENT
  DEVICE_FINGERPRINT
  CONTENT_IDENTIFIER
  CAMPAIGN_IDENTIFIER
}

enum ThreatIntelConfidenceLevel {
  UNTRUSTED
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum ThreatIntelIndicatorStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  REVOKED
}

enum ThreatIntelCampaignStatus {
  OBSERVED
  ACTIVE
  ESCALATED
  CONTAINED
  RESOLVED
  ARCHIVED
}

enum ThreatIntelSourceHealthStatus {
  HEALTHY
  DEGRADED
  FAILED
  DISABLED
}

model ThreatIntelSource {
  id                   String                    @id @default(uuid())
  name                 String                    @unique
  providerType         String // "COMMERCIAL_FEED", "OPEN_SOURCE", "INDUSTRY_ISAC", "STUDIO_ALLIANCE", "CUSTOM_WEBHOOK"
  description          String?
  trustLevel           Int                       @default(50) // 0-100 base reliability
  defaultConfidence    Int                       @default(50)
  isEnabled            Boolean                   @default(true)
  authConfigReference  String? // Masked reference / secret key name (never plaintext secret)
  webhookSecretHash    String? // Salted hash for webhook verification
  lastSyncSuccessAt    DateTime?
  lastSyncFailureAt    DateTime?
  lastFailureReason    String?
  syncFrequencyMinutes Int                       @default(60)
  feeds                ThreatIntelFeed[]
  indicators           ThreatIntelIndicator[]
  healthRecords        ThreatIntelSourceHealth[]
  imports              ThreatIntelImport[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([providerType])
  @@index([isEnabled])
  @@index([trustLevel])
}

model ThreatIntelFeed {
  id                   String            @id @default(uuid())
  sourceId             String
  source               ThreatIntelSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  feedName             String
  feedUrl              String?
  feedFormat           String            @default("JSON") // "JSON", "CSV", "REST", "WEBHOOK"
  isActive             Boolean           @default(true)
  lastPolledAt         DateTime?
  pollIntervalSec      Int               @default(3600)
  totalRecordsIngested Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([sourceId])
  @@index([isActive])
}

model ThreatIntelIndicator {
  id                   String                     @id @default(uuid())
  sourceId             String
  source               ThreatIntelSource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  indicatorType        ThreatIntelIndicatorType
  value                String // Normalized canonical value
  rawValue             String? // Original raw ingested value
  confidenceScore      Int                        @default(50) // 0-100
  confidenceLevel      ThreatIntelConfidenceLevel @default(MODERATE)
  status               ThreatIntelIndicatorStatus @default(ACTIVE)
  threatClassification String? // e.g. "CAM_RECORDING_DISTRIBUTOR", "TOKEN_LEECH_NODE", "PIRACY_CDN"
  description          String?
  tags                 String? // Comma-separated or JSON array of tags
  firstSeen            DateTime                   @default(now())
  lastSeen             DateTime                   @default(now())
  expiresAt            DateTime?
  isAnalystValidated   Boolean                    @default(false)
  validatedBy          String?
  validatedAt          DateTime?
  observations         ThreatIntelObservation[]
  relationshipsFrom    ThreatIntelRelationship[]  @relation("SourceIndicator")
  relationshipsTo      ThreatIntelRelationship[]  @relation("TargetIndicator")
  matches              ThreatIntelMatch[]
  campaigns            ThreatIntelCampaign[]      @relation("CampaignIndicators")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([sourceId, indicatorType, value])
  @@index([indicatorType])
  @@index([value])
  @@index([confidenceScore])
  @@index([confidenceLevel])
  @@index([status])
  @@index([expiresAt])
  @@index([threatClassification])
}

model ThreatIntelObservation {
  id               String               @id @default(uuid())
  indicatorId      String
  indicator        ThreatIntelIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  sightingSource   String // Feed name or external telemetry context
  contextTelemetry String? // Non-PII metadata
  timestamp        DateTime             @default(now())

  @@index([indicatorId])
  @@index([timestamp])
}

model ThreatIntelRelationship {
  id                String               @id @default(uuid())
  sourceIndicatorId String
  sourceIndicator   ThreatIntelIndicator @relation("SourceIndicator", fields: [sourceIndicatorId], references: [id], onDelete: Cascade)
  targetIndicatorId String
  targetIndicator   ThreatIntelIndicator @relation("TargetIndicator", fields: [targetIndicatorId], references: [id], onDelete: Cascade)
  relationshipType  String // "HOSTED_ON", "COMMUNICATES_WITH", "BELONGS_TO_CAMPAIGN", "DUPLICATE_OF"
  confidence        Int                  @default(50)
  createdAt         DateTime             @default(now())

  @@unique([sourceIndicatorId, targetIndicatorId, relationshipType])
  @@index([sourceIndicatorId])
  @@index([targetIndicatorId])
}

model ThreatIntelCampaign {
  id                   String                    @id @default(uuid())
  campaignIdentifier   String                    @unique // e.g. "CMP-2026-NIGHTSHADE"
  name                 String
  description          String?
  threatClassification String // "GLOBAL_THEATRICAL_LEAK", "WATERMARK_STRIP_CAMPAIGN", "SYNDICATED_PIRACY_NETWORK"
  riskLevel            String                    @default("HIGH") // "CRITICAL", "HIGH", "MEDIUM", "LOW"
  confidence           Int                       @default(75)
  status               ThreatIntelCampaignStatus @default(OBSERVED)
  indicators           ThreatIntelIndicator[]    @relation("CampaignIndicators")
  theatreId            String?
  theatre              Theatre?                  @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  movieId              String?
  movie                Movie?                    @relation(fields: [movieId], references: [id], onDelete: SetNull)
  productionCompanyId  String?
  productionCompany    ProductionCompany?        @relation(fields: [productionCompanyId], references: [id], onDelete: SetNull)
  investigationCaseId  String?
  investigationCase    InvestigationCase?        @relation(fields: [investigationCaseId], references: [id], onDelete: SetNull)
  evidenceRecordId     String?
  evidenceRecord       EvidenceRecord?           @relation(fields: [evidenceRecordId], references: [id], onDelete: SetNull)
  matches              ThreatIntelMatch[]
  firstObservedAt      DateTime                  @default(now())
  lastObservedAt       DateTime                  @default(now())
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([campaignIdentifier])
  @@index([status])
  @@index([threatClassification])
  @@index([theatreId])
  @@index([movieId])
  @@index([productionCompanyId])
}

model ThreatIntelMatch {
  id                  String               @id @default(uuid())
  indicatorId         String
  indicator           ThreatIntelIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  campaignId          String?
  campaign            ThreatIntelCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  correlationType     String // "IP_AUDIT_MATCH", "PLAYBACK_SESSION_IP", "DEVICE_FINGERPRINT_HIT", "USER_AGENT_MATCH", "WATERMARK_HASH_CORRELATION"
  correlationDetails  String? // Context of internal match
  confidence          Int                  @default(80)
  theatreId           String?
  theatre             Theatre?             @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  movieId             String?
  movie               Movie?               @relation(fields: [movieId], references: [id], onDelete: SetNull)
  playbackSessionId   String?
  playbackSession     PlaybackSession?     @relation(fields: [playbackSessionId], references: [id], onDelete: SetNull)
  investigationCaseId String?
  investigationCase   InvestigationCase?   @relation(fields: [investigationCaseId], references: [id], onDelete: SetNull)
  evidenceRecordId    String?
  evidenceRecord      EvidenceRecord?      @relation(fields: [evidenceRecordId], references: [id], onDelete: SetNull)
  securityAuditLogId  String?
  matchedAt           DateTime             @default(now())

  @@index([indicatorId])
  @@index([campaignId])
  @@index([theatreId])
  @@index([movieId])
  @@index([playbackSessionId])
  @@index([matchedAt])
}

model ThreatIntelSourceHealth {
  id                String                        @id @default(uuid())
  sourceId          String
  source            ThreatIntelSource             @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status            ThreatIntelSourceHealthStatus @default(HEALTHY)
  responseLatencyMs Int                           @default(0)
  lastHttpCode      Int?
  recordsIngested   Int                           @default(0)
  errorMessage      String?
  checkedAt         DateTime                      @default(now())

  @@index([sourceId])
  @@index([status])
  @@index([checkedAt])
}

model ThreatIntelImport {
  id             String             @id @default(uuid())
  sourceId       String?
  source         ThreatIntelSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  importFormat   String // "CSV", "JSON", "REST", "WEBHOOK", "MANUAL"
  fileName       String?
  totalRecords   Int                @default(0)
  importedCount  Int                @default(0)
  duplicateCount Int                @default(0)
  rejectedCount  Int                @default(0)
  status         String             @default("COMPLETED") // "COMPLETED", "FAILED", "PARTIAL"
  errorMessage   String?
  importedBy     String? // User email or "SYSTEM"
  createdAt      DateTime           @default(now())

  @@index([sourceId])
  @@index([status])
  @@index([createdAt])
}

model ThreatIntelAction {
  id          String   @id @default(uuid())
  actionType  String // "ANALYST_VALIDATE", "MARK_FALSE_POSITIVE", "ESCALATE_TO_INCIDENT", "CREATE_EVIDENCE"
  indicatorId String?
  campaignId  String?
  actorId     String
  actorEmail  String?
  actorRole   String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([actionType])
  @@index([actorId])
  @@index([createdAt])
}

// ==========================================
// PHASE 19: ZERO-TRUST & ENTERPRISE GOVERNANCE
// ==========================================

enum PolicyType {
  ACCESS_CONTROL
  PLAYBACK_AUTHORIZATION
  DRM_LICENSE
  EVIDENCE_ACCESS
  INVESTIGATION_CASE
  THREAT_INTEL
  ADMIN_OPERATIONS
  DATA_EXPORT
  EMERGENCY_ACCESS
}

enum AccessDecisionType {
  ALLOW
  STEP_UP
  APPROVAL_REQUIRED
  DENY
}

enum DeviceTrustStatus {
  TRUSTED
  UNKNOWN
  SUSPICIOUS
  BLOCKED
}

enum PrivilegedActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  EXPIRED
  CANCELLED
}

enum PrivilegedRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GovernanceEventType {
  POLICY_CREATED
  POLICY_MODIFIED
  POLICY_ACTIVATED
  POLICY_ROLLBACK
  PRIVILEGED_ACTION_REQUESTED
  PRIVILEGED_ACTION_APPROVED
  PRIVILEGED_ACTION_REJECTED
  PRIVILEGED_ACTION_EXECUTED
  BREAK_GLASS_ACTIVATED
  BREAK_GLASS_CLOSED
  BREAK_GLASS_EXPIRED
  DEVICE_TRUST_UPDATED
}

model SecurityPolicy {
  id          String          @id @default(uuid())
  name        String
  description String?
  policyType  PolicyType      @default(ACCESS_CONTROL)
  isEnabled   Boolean         @default(true)
  priority    Int             @default(100) // Lower integer = higher evaluation priority
  version     Int             @default(1)
  rules       String // JSON array of rule definitions
  tenantType  String? // "GLOBAL", "PRODUCTION_COMPANY", "THEATRE"
  tenantId    String?
  effectiveAt DateTime        @default(now())
  expiresAt   DateTime?
  createdBy   String?
  updatedBy   String?
  versions    PolicyVersion[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([policyType])
  @@index([isEnabled])
  @@index([priority])
  @@index([tenantType, tenantId])
  @@index([createdAt])
}

model PolicyVersion {
  id           String         @id @default(uuid())
  policyId     String
  policy       SecurityPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version      Int
  ruleSnapshot String // JSON stringified rules
  changeReason String?
  createdBy    String?
  createdAt    DateTime       @default(now())

  @@index([policyId])
  @@index([version])
  @@index([createdAt])
}

model AccessDecision {
  id                  String             @id @default(uuid())
  actorId             String?
  actorEmail          String?
  actorRole           String?
  resourceType        String // "PLAYBACK", "DRM", "EVIDENCE", "CASE", "INTEL", "POLICY", "SYSTEM"
  resourceId          String?
  action              String // "READ", "WRITE", "EXECUTE", "TERMINATE", "EXPORT", "DELETE"
  decision            AccessDecisionType
  riskScore           Int                @default(0) // 0 - 100
  trustScore          Int                @default(100) // 0 - 100
  evaluatedPolicyIds  String? // JSON array or comma-separated policy IDs
  reasonCodes         String // Comma-separated reason codes e.g. "TRUSTED_DEVICE,CLEAN_TELEMETRY"
  correlationId       String
  ipAddress           String?
  deviceFingerprint   String?
  theatreId           String?
  productionCompanyId String?
  timestamp           DateTime           @default(now())

  @@index([decision])
  @@index([actorRole])
  @@index([resourceType])
  @@index([correlationId])
  @@index([timestamp])
}

model DeviceTrustRecord {
  id                    String            @id @default(uuid())
  deviceFingerprintHash String            @unique // Privacy-preserving SHA-256 hash
  deviceName            String?
  trustStatus           DeviceTrustStatus @default(UNKNOWN)
  lastSeenIp            String?
  firstSeenAt           DateTime          @default(now())
  lastSeenAt            DateTime          @default(now())
  trustScore            Int               @default(50)
  riskFactors           String? // JSON list of risk factor codes
  observationCount      Int               @default(1)
  trustRevokedAt        DateTime?
  trustRevokedReason    String?
  trustGrantedBy        String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([trustStatus])
  @@index([trustScore])
  @@index([lastSeenAt])
}

model PrivilegedActionRequest {
  id               String                 @id @default(uuid())
  actionType       String // "DRM_LICENSE_REVOKE", "PLAYBACK_TERMINATE", "TOKEN_BLACKLIST", "POLICY_MODIFY", etc.
  requestedBy      String
  requesterEmail   String?
  requesterRole    String?
  targetResource   String
  targetResourceId String?
  reason           String
  riskLevel        PrivilegedRiskLevel    @default(HIGH)
  approvalStatus   PrivilegedActionStatus @default(PENDING_APPROVAL)
  approverId       String?
  approverEmail    String?
  approvalNotes    String?
  approvedAt       DateTime?
  executedAt       DateTime?
  executionToken   String? // Cryptographically random one-time token
  executionResult  String?
  expiresAt        DateTime // Short-lived window (e.g. 15 mins)
  correlationId    String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([approvalStatus])
  @@index([actionType])
  @@index([riskLevel])
  @@index([requestedBy])
  @@index([expiresAt])
}

model BreakGlassSession {
  id                    String    @id @default(uuid())
  sessionIdentifier     String    @unique // "BG-YYYY-XXXX"
  activatedBy           String
  activatorEmail        String?
  reason                String
  isActive              Boolean   @default(true)
  activatedAt           DateTime  @default(now())
  expiresAt             DateTime
  closedAt              DateTime?
  closedBy              String?
  postReviewRequired    Boolean   @default(true)
  postReviewCompleted   Boolean   @default(false)
  postReviewCompletedAt DateTime?
  postReviewCompletedBy String?
  postReviewNotes       String?
  correlationId         String
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([sessionIdentifier])
  @@index([isActive])
  @@index([activatedBy])
  @@index([expiresAt])
}

model GovernanceAuditEvent {
  id            String              @id @default(uuid())
  eventType     GovernanceEventType
  severity      SecuritySeverity    @default(INFO)
  actorId       String?
  actorEmail    String?
  actorRole     String?
  targetType    String // "POLICY", "PRIVILEGED_ACTION", "BREAK_GLASS", "DEVICE", "SYSTEM"
  targetId      String?
  actionSummary String
  changes       String? // JSON snapshot of configuration state change
  correlationId String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime            @default(now())

  @@index([eventType])
  @@index([severity])
  @@index([targetType])
  @@index([correlationId])
  @@index([createdAt])
}

// ==========================================
// PHASE 20: ENTERPRISE THREAT OPERATIONS & UNIFIED SOC
// ==========================================

model SecurityIncidentTimeline {
  id             String           @id @default(uuid())
  incidentId     String
  incident       SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  eventType      String // "STATUS_CHANGE", "ESCALATION", "ANALYST_ASSIGNED", "CONTAINMENT", "NOTE_ADDED", "IOC_LINKED"
  description    String
  actorId        String?
  actorEmail     String?
  actorRole      String?
  previousStatus String?
  newStatus      String?
  metadata       String? // JSON string
  timestamp      DateTime         @default(now())

  @@index([incidentId])
  @@index([eventType])
  @@index([timestamp])
}

model SecurityWorkflow {
  id               String                      @id @default(uuid())
  name             String
  description      String?
  triggerType      String // "THREAT_RISK_THRESHOLD", "REPEAT_IOC_CORRELATION", "EVIDENCE_TAMPERING", "COORDINATED_ATTACK", "PRIVILEGED_ACTION_REQUEST", "BREAK_GLASS_ACTIVE", "UNRESOLVED_THREAT"
  triggerCondition String // JSON configuration
  actionType       String // "CREATE_INVESTIGATION", "ESCALATE_INCIDENT", "CREATE_CRITICAL_ALERT", "NOTIFY_SOC", "REQUIRE_APPROVAL", "MANDATORY_REVIEW"
  actionPayload    String? // JSON payload
  isEnabled        Boolean                     @default(true)
  priority         Int                         @default(100)
  tenantType       String? // "GLOBAL", "PRODUCTION_COMPANY", "THEATRE"
  tenantId         String?
  createdBy        String?
  executions       SecurityWorkflowExecution[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([triggerType])
  @@index([isEnabled])
  @@index([priority])
  @@index([createdAt])
}

model SecurityWorkflowExecution {
  id            String           @id @default(uuid())
  workflowId    String
  workflow      SecurityWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  triggerEvent  String
  decision      String // "EXECUTED", "SKIPPED", "REQUIRES_APPROVAL", "FAILED"
  actionTaken   String
  status        String           @default("SUCCESS") // "SUCCESS", "FAILED", "PENDING_APPROVAL"
  result        String? // JSON result
  actorId       String?
  actorEmail    String?
  correlationId String
  executedAt    DateTime         @default(now())

  @@index([workflowId])
  @@index([status])
  @@index([correlationId])
  @@index([executedAt])
}

model SecurityNotification {
  id                  String           @id @default(uuid())
  category            String // "CRITICAL_SECURITY_EVENT", "HIGH_RISK_INCIDENT", "EVIDENCE_TAMPERING", "IOC_CORRELATION", "COORDINATED_ATTACK", "PRIVILEGED_ACTION", "BREAK_GLASS", "SYSTEM_HEALTH"
  severity            IncidentSeverity @default(MEDIUM)
  title               String
  message             String
  targetRole          String? // "ADMIN", "THEATRE_ADMIN", "PRODUCTION_COMPANY", "ALL"
  targetUserId        String?
  theatreId           String?
  productionCompanyId String?
  isRead              Boolean          @default(false)
  isMuted             Boolean          @default(false)
  deduplicationKey    String? // SHA-256 or key for deduplication
  correlationId       String
  createdAt           DateTime         @default(now())

  @@index([category])
  @@index([severity])
  @@index([isRead])
  @@index([targetRole])
  @@index([deduplicationKey])
  @@index([createdAt])
}

model SecurityEscalation {
  id            String           @id @default(uuid())
  incidentId    String
  incident      SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fromSeverity  IncidentSeverity
  toSeverity    IncidentSeverity
  fromRisk      Int              @default(0)
  toRisk        Int              @default(0)
  reason        String
  triggeredBy   String // "AUTOMATED_POLICY", "ANALYST_ACTION", "IOC_CORRELATION", "EVIDENCE_TAMPERING"
  policyId      String?
  correlationId String
  createdAt     DateTime         @default(now())

  @@index([incidentId])
  @@index([triggeredBy])
  @@index([correlationId])
  @@index([createdAt])
}
