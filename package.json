{
  "name": "theatre-anti-piracy-system",
  "version": "1.0.0",
  "description": "Theatre Anti-Piracy QR Activation & Verification System - Phase 1",
  "private": true,
  "workspaces": [
    "database",
    "api",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "test:orchestration": "npm run test:orchestration --workspace=api",
    "test:mobile": "npm run test:mobile --workspace=api",
    "test:evidence": "npm run test:evidence --workspace=api",
    "test:soc": "npm run test:soc --workspace=api",
    "test:investigation": "npm run test:investigation --workspace=api",
    "test:enforcement": "npm run test:enforcement --workspace=api",
    "test:intelligence": "npm run test:intelligence --workspace=api",
    "test:recovery": "npm run test:recovery --workspace=api",
    "test:disaster-recovery": "npm run test:disaster-recovery --workspace=api",
    "test:production": "npm run test:production --workspace=api",
    "test:observability": "npm run test:observability --workspace=api",
    "test:android-prod": "npm run test:android-prod --workspace=api",
    "test:tenant-iso": "npm run test:tenant-iso --workspace=api",
    "test:evidence-cert": "npm run test:evidence-cert --workspace=api",
    "test:go-live": "npm run test:go-live --workspace=api",
    "test:validation": "npm run test:validation --workspace=api",
    "test:e2e-validation": "npm run test:e2e-validation --workspace=api",
    "test:smoke-prod": "npm run test:smoke-prod --workspace=api",
    "test:security-baseline": "npm run test:security-baseline --workspace=api",
    "test:oat": "npm run test:oat --workspace=api",
    "test:drill": "npm run test:drill --workspace=api",
    "test:multi-tenant": "npm run test:multi-tenant --workspace=api",
    "test:real-data-e2e": "npm run test:real-data-e2e --workspace=api",
    "validate:production-config": "npm run validate:production-config --workspace=api",
    "validate:migrations": "npm run validate:migrations --workspace=api",
    "validate:deployment": "npm run validate:deployment --workspace=api",
    "smoke:production": "npm run smoke:production --workspace=api",
    "release:check": "npm run release:check --workspace=api",
    "db:generate": "prisma generate --schema=database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=database/prisma/schema.prisma"
  },
  "keywords": [
    "anti-piracy",
    "theatre",
    "qr-verification",
    "nextjs",
    "prisma",
    "typescript"
  ],
