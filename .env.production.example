# ==============================================================================
# Theatre Anti-Piracy Platform — Production Environment Configuration Template
# ==============================================================================
# WARNING: NEVER commit actual production secrets or private keys to source control.
# Copy this file to .env.production on your secure production deployment host.
# ==============================================================================

# 1. CORE APPLICATION RUNTIME
NODE_ENV=production
PORT=4000
API_BASE_URL=https://api.theatre-antipiracy.net
WEB_BASE_URL=https://app.theatre-antipiracy.net
APP_VERSION=2.4.0
LOG_LEVEL=info
TRUST_PROXY=true
REQUEST_TIMEOUT_MS=30000
DRAIN_TIMEOUT_MS=15000
MAINTENANCE_MODE=false

# 2. DATABASE CONFIGURATION (PostgreSQL Connection Pooling)
# Primary pooled database connection
DATABASE_URL="postgresql://theatre_prod_user:SECURE_PASSWORD@prod-db.internal.cloud:5432/theatre_antipiracy_prod?schema=public&sslmode=require&connection_limit=50&pool_timeout=15"
# Direct database connection for migrations
DATABASE_DIRECT_URL="postgresql://theatre_prod_user:SECURE_PASSWORD@prod-db.internal.cloud:5432/theatre_antipiracy_prod?schema=public&sslmode=require"

# 3. AUTHENTICATION & JWT SECURITY
# Generate with: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_MINIMUM_64_CHAR_CRYPTOGRAPHICALLY_RANDOM_SECRET"
JWT_ISSUER="https://api.theatre-antipiracy.net"
JWT_AUDIENCE="https://app.theatre-antipiracy.net"
JWT_EXPIRY="4h"

# 4. CROSS-ORIGIN RESOURCE SHARING (CORS)
# Strict production domain whitelisting (NO WILDCARDS)
CORS_ORIGIN="https://app.theatre-antipiracy.net,https://admin.theatre-antipiracy.net"

# 5. CLOUD OBJECT STORAGE (S3 / GCS / Azure Blob)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=theatre-antipiracy-encrypted-masters-prod
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=s3.us-east-1.amazonaws.com
STORAGE_ACCESS_KEY=PROD_OBJECT_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=PROD_OBJECT_STORAGE_SECRET_KEY

# 6. CONTENT DELIVERY NETWORK (CDN) & SIGNED DELIVERY
CDN_BASE_URL=https://media-cdn.theatre-antipiracy.net
CDN_SIGNING_KEY_ID=K3_PROD_CDN_KEY
CDN_SIGNING_SECRET=REPLACE_WITH_HMAC_SHA256_CDN_SIGNING_SECRET

# 7. DIGITAL RIGHTS MANAGEMENT (DRM)
DRM_PROVIDER=widevine
DRM_LICENSE_SERVER_URL=https://license.widevine.theatre-antipiracy.net/v1/license
DRM_API_KEY=COMMERCIAL_DRM_VENDOR_PROD_API_KEY
DRM_KEY_ID=WV_PROD_ORG_KEY_ID

# 8. CLOUD KEY MANAGEMENT SERVICE (KMS)
KMS_PROVIDER=aws_kms
KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/prod-antipiracy-master-key

# 9. DISASTER RECOVERY & S3 REPLICATION
S3_BACKUP_BUCKET=theatre-antipiracy-disaster-recovery-prod
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_AES256_BACKUP_ENCRYPTION_KEY
