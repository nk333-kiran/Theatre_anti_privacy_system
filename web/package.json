{
  "name": "@antipiracy/web",
  "version": "1.0.0",
  "description": "Frontend Admin Dashboard for Theatre Anti-Piracy System",
  "private": true,
  "scripts": {
    "predev": "node -e \"const fs=require('fs'); if(fs.existsSync('.next')) fs.rmSync('.next', {recursive:true, force:true})\"",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "prebuild": "node -e \"const fs=require('fs'); if(fs.existsSync('.next')) fs.rmSync('.next', {recursive:true, force:true})\"",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hls.js": "^1.7.1",
    "lucide-react": "^0.460.0",
