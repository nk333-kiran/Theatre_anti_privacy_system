# ==========================================
# Production Multi-Stage Dockerfile for Background Workers
# ==========================================

# Stage 1: Build & Dependencies
FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package*.json ./
COPY database/package*.json ./database/
COPY api/package*.json ./api/

RUN npm install

COPY database ./database
COPY api ./api

RUN npm run build --workspace=@antipiracy/database
RUN npm run build --workspace=@antipiracy/api

# Stage 2: Production Worker Runtime
FROM node:20-alpine AS runner

WORKDIR /app

# Install FFmpeg & Bento4/mp4box tools for video transcoding and HLS packaging
RUN apk add --no-cache ffmpeg curl

ENV NODE_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nodejs

COPY package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/database ./database
COPY --from=builder /app/api/dist ./api/dist
COPY --from=builder /app/api/package*.json ./api/

RUN mkdir -p /app/private_storage/raw /app/private_storage/processed /app/private_storage/hls && \
    chown -R nodejs:nodejs /app

USER nodejs

CMD ["node", "api/dist/index.js"]
